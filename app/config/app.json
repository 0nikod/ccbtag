{
  "tag": {
    "separator": ", ",
    "threshold": 0.35,
    "max_tags": 80,
    "replace_underscore": true,
    "sort_by_score": true,
    "blacklist": [
    ],
    "replace_rules": {
    }
  },
  "nl": {
    "max_length": 512,
    "language": "en",
    "use_tags_as_context": true,
    "shuffle_tags": true
  },
  "caption": {
