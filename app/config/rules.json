{
  "tag": {
    "separator": ", ",
    "threshold": 0.35,
    "max_tags": 80,
    "replace_underscore": true,
    "sort_by_score": true,
    "blacklist": [
      "lowres",
      "watermark",
      "signature",
      "username",
      "jpeg artifacts"
    ],
    "replace_rules": {
      "grey hair": "gray hair",
      "looking_at_viewer": "looking at viewer"
    }
  },
  "nl": {
    "max_length": 128,
    "language": "en",
    "use_tags_as_context": true
  },
  "caption": {
    "order": ["tag", "nl"],
    "joiner": ". ",
    "save_txt": true,
    "save_metadata_json": true,
    "metadata_location": "caption_json"
  }
}
